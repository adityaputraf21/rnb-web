generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/* ========================================================================== */
/*  Auth.js (NextAuth v5) models                                               */
/* ========================================================================== */

enum Role {
  USER
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profil forum
  username    String  @unique
  bio         String?
  website     String?
  bannerColor String?
  bannerImage String?
  discordId   String? @unique
  role        Role    @default(USER)
  points      Int     @default(0)
  tier        String  @default("Bronze")

  bannedAt    DateTime?
  bannedUntil DateTime? // null + bannedAt = permanen; terisi = ban sementara
  banReason   String?
  mutedUntil  DateTime?

  featuredAchievement String? // key achievement yang dipajang di profil
  notifyEmailDigest   Boolean @default(false)

  // Preferensi notifikasi
  notifyMention  Boolean @default(true)
  notifyReply    Boolean @default(true)
  notifyReaction Boolean @default(true)
  notifyFollow   Boolean @default(true)

  // Streak & onboarding
  streakCount  Int       @default(0)
  streakLastAt DateTime?
  onboardedAt  DateTime?

  mutedKeywords  String? // dipisah koma, sembunyikan post yang mengandung
  pinnedThreadId String?
  invitedById    String?

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  threads       Thread[]
  posts         Post[]
  reactions     Reaction[]
  attachments   Attachment[]
  announcements Announcement[]
  events        Event[]
  bookmarks     Bookmark[]
  subscriptions ThreadSubscription[]
  achievements  UserAchievement[]
  statuses        Status[]
  statusLikes     StatusLike[]
  statusComments  StatusComment[]
  statusReactions StatusReaction[]
  pollVotes       PollVote[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
  blocking  Block[]  @relation("blocker")
  blockedBy Block[]  @relation("blocked")
  warnings         Warning[] @relation("warned")
  warningsIssued   Warning[] @relation("warner")
  conversationsA Conversation[] @relation("convA")
  conversationsB Conversation[] @relation("convB")
  messagesSent     Message[]
  messageReactions MessageReaction[]
  stories          Story[]
  storyViews       StoryView[]
  storyReactions   StoryReaction[]
  highlights       Highlight[]
  pushSubs         PushSubscription[]
  bookmarkFolders  BookmarkFolder[]
  eventRsvps       EventRSVP[]
  appeals          Appeal[]        @relation("appellant")
  appealsReviewed  Appeal[]        @relation("appealReviewer")
  modNotesAbout    ModNote[]       @relation("modNoteTarget")
  modNotesWritten  ModNote[]       @relation("modNoteAuthor")
  invitesCreated   Invite[]        @relation("inviter")
  invitedBy        User?           @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees         User[]          @relation("invitedBy")

  notifications      Notification[] @relation("recipient")
  actedNotifications Notification[] @relation("actor")
  auditLogs          AuditLog[]     @relation("moderator")
  reportsMade        Report[]       @relation("reporter")
  reportsResolved    Report[]       @relation("resolver")

  articles         Article[]     @relation("articleAuthor")
  questClaims      QuestClaim[]
  groupsOwned      GroupChat[]   @relation("groupOwner")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]

  closeFriends   CloseFriend[]   @relation("cfOwner")
  closeFriendOf  CloseFriend[]   @relation("cfFriend")
  threadMutes    ThreadMute[]
  drafts         Draft[]
  storyPollVotes StoryPollVote[]
  seasonAwards   SeasonAward[]

  @@index([points])
  @@index([lastSeenAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Warning {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String?
  reason      String
  severity    Int       @default(1)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user      User  @relation("warned", fields: [userId], references: [id], onDelete: Cascade)
  moderator User? @relation("warner", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/* ========================================================================== */
/*  Site config (singleton, id = "singleton")                                  */
/* ========================================================================== */

model SiteConfig {
  id               String   @id @default("singleton")
  siteName         String   @default("RnB")
  tagline          String   @default("Rise Never Break")
  bannerText       String?
  bannerVariant    String   @default("info") // info | warning | success
  registrationOpen Boolean  @default(true)
  maintenanceMode  Boolean  @default(false)
  webhookUsername  String   @default("RnB")
  webhookAvatar    String?
  bannedWords      String?  // dipisah baris baru; cocok = konten diblokir

  // Blog / quest
  blogEnabled   Boolean @default(true)
  questsEnabled Boolean @default(true)

  // Integrasi guild Discord
  requireGuild       Boolean @default(false) // wajib jadi member guild untuk login
  discordGuildId     String?
  discordModRoleId   String? // role Discord -> MODERATOR di web
  discordAdminRoleId String? // role Discord -> ADMIN di web

  updatedAt DateTime @updatedAt
}

/* Cache preview link (Open Graph) */
model LinkPreview {
  url         String   @id
  title       String?
  description String?
  image       String?
  siteName    String?
  fetchedAt   DateTime @default(now())
}

/* ========================================================================== */
/*  Forum                                                                      */
/* ========================================================================== */

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#5865F2")
  position    Int      @default(0)
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())

  threads Thread[]

  @@index([position])
}

model Thread {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  categoryId String
  authorId   String?
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  views      Int      @default(0)
  bestPostId String?  @unique
  createdAt  DateTime @default(now())
  lastPostAt DateTime @default(now())
  deletedAt  DateTime?

  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author        User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  posts         Post[]
  bookmarks     Bookmark[]
  subscriptions ThreadSubscription[]
  mutes         ThreadMute[]
  poll          Poll?

  @@index([categoryId, pinned, lastPostAt])
  @@index([lastPostAt])
}

model Post {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions   Reaction[]
  attachments Attachment[]

  @@index([threadId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model Attachment {
  id          String   @id @default(cuid())
  url         String
  pathname    String
  name        String
  contentType String
  size        Int
  uploaderId  String?
  postId      String?
  createdAt   DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  post     Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String?
  statusId  String?
  folderId  String?
  createdAt DateTime @default(now())

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread?         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status Status?         @relation(fields: [statusId], references: [id], onDelete: Cascade)
  folder BookmarkFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([userId, threadId])
  @@unique([userId, statusId])
  @@index([userId, createdAt])
}

model BookmarkFolder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([userId])
}

model ThreadSubscription {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
}

/* ========================================================================== */
/*  Feed (status sosial)                                                       */
/* ========================================================================== */

model Status {
  id         String    @id @default(cuid())
  authorId   String?
  body       String
  pinned     Boolean   @default(false)
  repostOfId    String?
  publishAt     DateTime  @default(now()) // untuk posting terjadwal
  mentionsSentAt DateTime? // null = notifikasi mention belum dikirim (scheduled)
  createdAt     DateTime  @default(now())
  editedAt   DateTime?
  deletedAt  DateTime?

  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  repostOf  Status?          @relation("repost", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts   Status[]         @relation("repost")
  images    StatusImage[]
  likes     StatusLike[]
  reactions StatusReaction[]
  comments  StatusComment[]
  bookmarks Bookmark[]
  poll      Poll?

  @@index([createdAt])
  @@index([authorId, createdAt])
  @@index([repostOfId])
  @@index([publishAt])
}

model StatusReaction {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId, emoji])
  @@index([statusId])
}

model StatusImage {
  id       String @id @default(cuid())
  statusId String
  url      String
  type     String @default("image") // image | video | audio | file
  name     String @default("")
  position Int    @default(0)

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@index([statusId])
}

model StatusLike {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  createdAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
  @@index([statusId])
}

model StatusComment {
  id        String    @id @default(cuid())
  statusId  String
  authorId  String?
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  status  Status          @relation(fields: [statusId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  StatusComment?  @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies StatusComment[] @relation("commentReplies")

  @@index([statusId, createdAt])
  @@index([parentId])
}

/* ========================================================================== */
/*  Polls (thread ATAU status, salah satu)                                     */
/* ========================================================================== */

model Poll {
  id        String       @id @default(cuid())
  threadId  String?      @unique
  statusId  String?      @unique
  question  String
  multiple  Boolean      @default(false)
  closesAt  DateTime?
  createdAt DateTime     @default(now())

  thread  Thread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status  Status?      @relation(fields: [statusId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  position Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/* ========================================================================== */
/*  Direct Messages                                                            */
/* ========================================================================== */

model Conversation {
  id            String    @id @default(cuid())
  aId           String // id user secara leksikografis lebih kecil
  bId           String
  lastMessageAt DateTime  @default(now())
  aMuted        Boolean   @default(false)
  bMuted        Boolean   @default(false)
  aClearedAt    DateTime? // sembunyikan pesan sebelum ini dari sisi A
  bClearedAt    DateTime?
  aTypingAt     DateTime?
  bTypingAt     DateTime?
  createdAt     DateTime  @default(now())

  a        User      @relation("convA", fields: [aId], references: [id], onDelete: Cascade)
  b        User      @relation("convB", fields: [bId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([aId, bId])
  @@index([lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String?
  body           String
  mediaUrl       String?
  mediaType      String?
  createdAt      DateTime  @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  readAt         DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?             @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Hashtag {
  tag        String   @id
  count      Int      @default(0)
  lastUsedAt DateTime @default(now())

  @@index([lastUsedAt])
  @@index([count])
}

/* ========================================================================== */
/*  Stories (ephemeral, 24 jam)                                                */
/* ========================================================================== */

model Story {
  id           String   @id @default(cuid())
  authorId     String?
  mediaUrl     String   @default("")
  mediaType    String // image | video | text
  bgColor      String? // untuk story teks
  caption      String?
  audience     String   @default("all") // all | close
  pollQuestion String?
  pollOptions  String[] @default([])
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  author    User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  views     StoryView[]
  reactions StoryReaction[]
  pollVotes StoryPollVote[]

  @@index([expiresAt])
  @@index([authorId, createdAt])
}

model StoryPollVote {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  choice    Int
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}

model Highlight {
  id        String   @id @default(cuid())
  userId    String
  mediaUrl  String   @default("")
  mediaType String
  bgColor   String?
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, position])
}

model StoryReaction {
  id        String   @id @default(cuid())
  storyId   String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([storyId])
}

model StoryView {
  id        String   @id @default(cuid())
  storyId   String
  viewerId  String
  createdAt DateTime @default(now())

  story  Story @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer User  @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@index([storyId])
}

/* ========================================================================== */
/*  Achievements                                                               */
/* ========================================================================== */

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  key      String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/* ========================================================================== */
/*  Notifications                                                              */
/* ========================================================================== */

enum NotificationType {
  MENTION
  REPLY
  REACTION
  MOD_ACTION
  SYSTEM
  ACHIEVEMENT
  FOLLOW
  DM
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  body      String?
  url       String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

/* ========================================================================== */
/*  Moderation                                                                 */
/* ========================================================================== */

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String?
  targetType String // "post" | "thread"
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  resolverId String?
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User? @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolver User? @relation("resolver", fields: [resolverId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  moderatorId String?
  action      String
  targetType  String
  targetId    String
  meta        Json?
  createdAt   DateTime @default(now())

  moderator User? @relation("moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/* ========================================================================== */
/*  Announcements & Events                                                     */
/* ========================================================================== */

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  source     String   @default("web") // "web" | "discord"
  authorId   String?
  authorName String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startsAt      DateTime?
  dateLabel     String
  location      String?
  source        String    @default("web")
  authorId      String?
  createdByName String?
  createdAt     DateTime  @default(now())

  author User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  rsvps  EventRSVP[]

  @@index([startsAt])
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("going") // going | maybe | no
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}

enum AppealStatus {
  OPEN
  ACCEPTED
  REJECTED
}

model Appeal {
  id         String       @id @default(cuid())
  userId     String
  body       String
  status     AppealStatus @default(OPEN)
  reviewerId String?
  note       String?
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  user     User  @relation("appellant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("appealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model ModNote {
  id        String   @id @default(cuid())
  userId    String // target
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  user   User  @relation("modNoteTarget", fields: [userId], references: [id], onDelete: Cascade)
  author User? @relation("modNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Invite {
  id        String    @id @default(cuid())
  code      String    @unique
  inviterId String
  uses      Int       @default(0)
  maxUses   Int       @default(0) // 0 = tak terbatas
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  inviter User @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([inviterId])
}

/* ========================================================================== */
/*  Blog / Artikel                                                             */
/* ========================================================================== */

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  body        String
  coverImage  String?
  published   Boolean   @default(false)
  authorId    String?
  views       Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User? @relation("articleAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([published, publishedAt])
}

/* ========================================================================== */
/*  Quest mingguan / musiman (progress dihitung on-demand, hanya klaim disimpan) */
/* ========================================================================== */

model QuestClaim {
  id        String   @id @default(cuid())
  userId    String
  questKey  String
  periodKey String // mis. "2026-W37" atau "2026-S3"
  reward    Int      @default(0)
  claimedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questKey, periodKey])
  @@index([userId, periodKey])
}

/* ========================================================================== */
/*  Group chat                                                                 */
/* ========================================================================== */

model GroupChat {
  id            String   @id @default(cuid())
  name          String
  image         String?
  ownerId       String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  owner    User?          @relation("groupOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members  GroupMember[]
  messages GroupMessage[]

  @@index([lastMessageAt])
}

model GroupMember {
  id         String    @id @default(cuid())
  groupId    String
  userId     String
  role       String    @default("member") // owner | member
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  group GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id        String    @id @default(cuid())
  groupId   String
  senderId  String?
  body      String
  mediaUrl  String?
  mediaType String?
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  group  GroupChat @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User?     @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([groupId, createdAt])
}

/* ========================================================================== */
/*  Close friends, mute thread, draf, reward musim                             */
/* ========================================================================== */

model CloseFriend {
  id        String   @id @default(cuid())
  ownerId   String
  friendId  String
  createdAt DateTime @default(now())

  owner  User @relation("cfOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  friend User @relation("cfFriend", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([ownerId, friendId])
  @@index([ownerId])
}

model ThreadMute {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
}

model Draft {
  id         String   @id @default(cuid())
  userId     String
  kind       String // status | thread
  title      String?
  body       String   @default("")
  categoryId String?
  media      Json?
  scheduledFor DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model SeasonAward {
  id        String   @id @default(cuid())
  userId    String
  season    Int
  rank      Int
  points    Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, season])
  @@index([season])
}
