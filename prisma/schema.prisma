generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/* ========================================================================== */
/*  Auth.js (NextAuth v5) models                                               */
/* ========================================================================== */

enum Role {
  USER
  MODERATOR
  ADMIN
  OWNER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Profil forum
  username    String  @unique
  bio         String?
  website     String?
  bannerColor String?
  bannerImage String?
  discordId   String? @unique
  role        Role    @default(USER)
  points      Int     @default(0)
  tier        String  @default("Bronze")

  bannedAt   DateTime?
  banReason  String?
  mutedUntil DateTime?

  // Preferensi notifikasi
  notifyMention  Boolean @default(true)
  notifyReply    Boolean @default(true)
  notifyReaction Boolean @default(true)
  notifyFollow   Boolean @default(true)

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  threads       Thread[]
  posts         Post[]
  reactions     Reaction[]
  attachments   Attachment[]
  announcements Announcement[]
  events        Event[]
  bookmarks     Bookmark[]
  subscriptions ThreadSubscription[]
  achievements  UserAchievement[]
  statuses        Status[]
  statusLikes     StatusLike[]
  statusComments  StatusComment[]
  statusReactions StatusReaction[]
  pollVotes       PollVote[]

  following Follow[] @relation("follower")
  followers Follow[] @relation("following")
  blocking  Block[]  @relation("blocker")
  blockedBy Block[]  @relation("blocked")
  warnings         Warning[] @relation("warned")
  warningsIssued   Warning[] @relation("warner")

  notifications      Notification[] @relation("recipient")
  actedNotifications Notification[] @relation("actor")
  auditLogs          AuditLog[]     @relation("moderator")
  reportsMade        Report[]       @relation("reporter")
  reportsResolved    Report[]       @relation("resolver")

  @@index([points])
  @@index([lastSeenAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}

model Warning {
  id          String    @id @default(cuid())
  userId      String
  moderatorId String?
  reason      String
  severity    Int       @default(1)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  user      User  @relation("warned", fields: [userId], references: [id], onDelete: Cascade)
  moderator User? @relation("warner", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/* ========================================================================== */
/*  Site config (singleton, id = "singleton")                                  */
/* ========================================================================== */

model SiteConfig {
  id               String   @id @default("singleton")
  siteName         String   @default("RnB")
  tagline          String   @default("Rise Never Break")
  bannerText       String?
  bannerVariant    String   @default("info") // info | warning | success
  registrationOpen Boolean  @default(true)
  maintenanceMode  Boolean  @default(false)
  webhookUsername  String   @default("RnB")
  webhookAvatar    String?
  bannedWords      String?  // dipisah baris baru; cocok = konten diblokir
  updatedAt        DateTime @updatedAt
}

/* Cache preview link (Open Graph) */
model LinkPreview {
  url         String   @id
  title       String?
  description String?
  image       String?
  siteName    String?
  fetchedAt   DateTime @default(now())
}

/* ========================================================================== */
/*  Forum                                                                      */
/* ========================================================================== */

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#5865F2")
  position    Int      @default(0)
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())

  threads Thread[]

  @@index([position])
}

model Thread {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  categoryId String
  authorId   String?
  pinned     Boolean  @default(false)
  locked     Boolean  @default(false)
  views      Int      @default(0)
  bestPostId String?  @unique
  createdAt  DateTime @default(now())
  lastPostAt DateTime @default(now())
  deletedAt  DateTime?

  category      Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author        User?               @relation(fields: [authorId], references: [id], onDelete: SetNull)
  posts         Post[]
  bookmarks     Bookmark[]
  subscriptions ThreadSubscription[]
  poll          Poll?

  @@index([categoryId, pinned, lastPostAt])
  @@index([lastPostAt])
}

model Post {
  id        String    @id @default(cuid())
  threadId  String
  authorId  String?
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  deletedAt DateTime?

  thread      Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reactions   Reaction[]
  attachments Attachment[]

  @@index([threadId, createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId, emoji])
  @@index([postId])
}

model Attachment {
  id          String   @id @default(cuid())
  url         String
  pathname    String
  name        String
  contentType String
  size        Int
  uploaderId  String?
  postId      String?
  createdAt   DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  post     Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([postId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([userId, createdAt])
}

model ThreadSubscription {
  id        String   @id @default(cuid())
  userId    String
  threadId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([userId, threadId])
  @@index([threadId])
}

/* ========================================================================== */
/*  Feed (status sosial)                                                       */
/* ========================================================================== */

model Status {
  id        String    @id @default(cuid())
  authorId  String?
  body      String
  pinned    Boolean   @default(false)
  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  images    StatusImage[]
  likes     StatusLike[]
  reactions StatusReaction[]
  comments  StatusComment[]
  poll      Poll?

  @@index([createdAt])
  @@index([authorId, createdAt])
}

model StatusReaction {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId, emoji])
  @@index([statusId])
}

model StatusImage {
  id       String @id @default(cuid())
  statusId String
  url      String
  position Int    @default(0)

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@index([statusId])
}

model StatusLike {
  id        String   @id @default(cuid())
  statusId  String
  userId    String
  createdAt DateTime @default(now())

  status Status @relation(fields: [statusId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([statusId, userId])
  @@index([statusId])
}

model StatusComment {
  id        String    @id @default(cuid())
  statusId  String
  authorId  String?
  parentId  String?
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  status  Status          @relation(fields: [statusId], references: [id], onDelete: Cascade)
  author  User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent  StatusComment?  @relation("commentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies StatusComment[] @relation("commentReplies")

  @@index([statusId, createdAt])
  @@index([parentId])
}

/* ========================================================================== */
/*  Polls (thread ATAU status, salah satu)                                     */
/* ========================================================================== */

model Poll {
  id        String       @id @default(cuid())
  threadId  String?      @unique
  statusId  String?      @unique
  question  String
  multiple  Boolean      @default(false)
  closesAt  DateTime?
  createdAt DateTime     @default(now())

  thread  Thread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  status  Status?      @relation(fields: [statusId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  text     String
  position Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id       String   @id @default(cuid())
  pollId   String
  optionId String
  userId   String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([optionId, userId])
  @@index([pollId, userId])
}

/* ========================================================================== */
/*  Achievements                                                               */
/* ========================================================================== */

model UserAchievement {
  id       String   @id @default(cuid())
  userId   String
  key      String
  earnedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/* ========================================================================== */
/*  Notifications                                                              */
/* ========================================================================== */

enum NotificationType {
  MENTION
  REPLY
  REACTION
  MOD_ACTION
  SYSTEM
  ACHIEVEMENT
  FOLLOW
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  actorId   String?
  type      NotificationType
  title     String
  body      String?
  url       String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user  User  @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

/* ========================================================================== */
/*  Moderation                                                                 */
/* ========================================================================== */

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String?
  targetType String // "post" | "thread"
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  resolverId String?
  resolution String?
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  reporter User? @relation("reporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolver User? @relation("resolver", fields: [resolverId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  moderatorId String?
  action      String
  targetType  String
  targetId    String
  meta        Json?
  createdAt   DateTime @default(now())

  moderator User? @relation("moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/* ========================================================================== */
/*  Announcements & Events                                                     */
/* ========================================================================== */

model Announcement {
  id         String   @id @default(cuid())
  title      String
  body       String
  source     String   @default("web") // "web" | "discord"
  authorId   String?
  authorName String?
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Event {
  id            String    @id @default(cuid())
  title         String
  description   String?
  startsAt      DateTime?
  dateLabel     String
  location      String?
  source        String    @default("web")
  authorId      String?
  createdByName String?
  createdAt     DateTime  @default(now())

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([startsAt])
}
