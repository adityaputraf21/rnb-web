# ============================================================================
#  Template env — SALIN ke .env.local dan isi nilai asli di sana.
#  JANGAN taruh secret asli di file ini (file ini ikut ke git).
# ============================================================================

# --- 1. Webhook KELUAR (website -> Discord) ---------------------------------
# Buat di: Server Settings > Integrations > Webhooks. Satu webhook per channel.
DISCORD_WEBHOOK_FORUM=
DISCORD_WEBHOOK_EVENT=
DISCORD_WEBHOOK_LEADERBOARD=
DISCORD_WEBHOOK_ANNOUNCEMENT=

# --- 2. Slash command MASUK (Discord -> website, HTTP Interactions) --------
# Ambil dari Discord Developer Portal > Applications > (app kamu)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=          # tab "General Information" -> Public Key
DISCORD_BOT_TOKEN=           # tab "Bot" -> Reset Token (hanya untuk register & reply)

# --- 3. Hanya untuk scripts/register-commands.js --------------------------
# ID server tempat kamu develop (klik kanan server > Copy Server ID; butuh Developer Mode)
DISCORD_DEV_GUILD_ID=

# --- Database (taruh di .env, bukan .env.local — Prisma CLI baca .env) --
# Postgres (Neon / Vercel Postgres / Supabase).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Umum ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rnb.web
