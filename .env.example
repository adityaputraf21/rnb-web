# ============================================================================
#  Template env — SALIN ke .env.local (secret) / .env (DB), isi nilai asli.
#  JANGAN taruh secret asli di file ini (ikut ke git).
# ============================================================================

# --- Database (di .env, dibaca Prisma CLI + Next) --------------------------
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# --- Auth.js (login Discord) ---------------------------------------------
AUTH_SECRET=            # `openssl rand -base64 32` atau `npx auth secret`
AUTH_DISCORD_ID=        # Client ID (= Application ID)
AUTH_DISCORD_SECRET=    # OAuth2 > Client Secret
# AUTH_URL hanya untuk lokal: http://localhost:3000 (di Vercel otomatis)

# --- Vercel Blob (upload) -----------------------------------------------
BLOB_READ_WRITE_TOKEN=  # Vercel > Storage > Blob (kosong = upload nonaktif)

# --- Discord webhook KELUAR (website -> Discord) ------------------------
DISCORD_WEBHOOK_FORUM=
DISCORD_WEBHOOK_EVENT=
DISCORD_WEBHOOK_LEADERBOARD=
DISCORD_WEBHOOK_ANNOUNCEMENT=

# --- Discord slash command MASUK (HTTP Interactions) ------------------
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# --- Hanya untuk scripts/register-commands.js -----------------------
DISCORD_DEV_GUILD_ID=

# --- Umum -----------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://rnb.web
